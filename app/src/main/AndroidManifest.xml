<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Chi de biet co mang hay khong, de chan nut Nop bai luc mat mang. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Chi de mo duoc hop thoai xin ra khoi danh sach tiet kiem pin. Nam trong
         danh sach do thi HyperOS dung tien trinh luc man hinh tat, va dich vu
         Telegram chet giua chung. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Du de liet ke app mo duoc tu man hinh chinh, khoi phai xin
         QUERY_ALL_PACKAGES von la quyen rong hon nhieu so voi viec can lam. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Phai khai bao rieng man hinh chinh va ban phim. Tu Android 11 app
             khong tu nhin thay app khac, thieu hai muc nay thi service coi man
             hinh chinh la app la va day no di, tablet thanh cuc gach. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
        <!-- Nut "Nhan cho ba Huy" mo Telegram bang link tg://, can thay app nao mo
             duoc link do. Xem TelegramThat.moChatVoiBa. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeworkGate">

        <!-- MOI MAN KHOA DOC, ca man chup. Ba Huy chon ngay 26/9/2026: tablet cua Le Hoa bat
             tu xoay, ma chay mot chieu thi khong phai lo bo cuc o chieu kia.

             Tru CuaVaoActivity: no khong co giao dien (Theme.NoDisplay, trong suot). Tren
             Android 8.0 - minSdk van la 26 - man trong suot ma khoa chieu thi app sap ngay
             luc bam icon ("Only fullscreen opaque activities can request orientation").

             configChanges van giu, lam lop chan thu hai: Android 16 tro len tren may man lon
             bo qua screenOrientation cua app nham SDK 36, va chia doi man hinh van doi co cua
             so. Luc do man tu ve lai chu khong bi dung lai. Dung lai man thi mat viec dang lam
             do: luot hoc thuoc bi chot giua chung, cac buoc chon bai ve lai tu dau, hop PIN
             dong mat, tin chat da toi Ba Huy ma khong vao khung chat nen con bam gui lan hai.
             Man chup chi khoa doc. Man moi cung phai khai ca hai: XoayManTest kiem. -->

        <!-- Icon app tro vao day chu khong vao thang HomeActivity. App dang chay thi
             bam icon chi dua lai dung man dang mo, giong mo tu danh sach app gan day.
             Xem CuaVaoActivity. -->
        <activity
            android:name=".ui.CuaVaoActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mo app la vao thang man cua Le Hoa. Day la app quan ly con, con dung
             no moi ngay; phan cua Ba Huy nam sau mot nut chu nho o goc.
             singleTask de guard va man chan mo no la dong het man nam tren. Van
             exported: tools/web.py mo thang no bang adb. -->
        <activity
            android:name=".ui.HomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <!-- exported=false de con khong mo thang bang adb hay shortcut. -->
        <activity
            android:name=".ui.ParentActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.CaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HomeworkGate.Camera" />

        <!-- Man con khai dang lam bai nao, di truoc man chup. -->
        <activity
            android:name=".ui.ChonBaiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Man con soat lai ban may doc, di sau man chup. adjustResize de ban phim
             khong che mat dong dang sua.

             Android dung lai man nay giua luc dang cham thi may cham lai tu dau, ton them mot
             luot AI, va nhung cau con vua bo ra cung mat. Xem chu thich dau file. -->
        <activity
            android:name=".ui.SoatBaiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- exported=false de con khong mo thang bang adb hay shortcut. -->
        <activity
            android:name=".ui.SetupActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.AppPickerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.SoanActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Android dung lai man dan do thi mat tam anh vua chup va ban may vua doc, chua co
             ban luu thi camera bat lai ngay. Xem chu thich dau file. -->
        <activity
            android:name=".ui.DanDoActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.TinActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Bai da cham: tung cau dung hay sai, sai thi may noi gi. Xem KetQuaActivity. -->
        <activity
            android:name=".ui.KetQuaActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.LichActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Hoc thuoc: may hoi, con go tra loi. adjustResize de ban phim khong che
             mat o go va thanh ky tu toan ngay duoi no. -->
        <activity
            android:name=".ui.HocThuocActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Do tu vung: may hoi mot tu, con tra loi. adjustResize cung mot le voi
             man tren - ban phim khong duoc che mat o go. -->
        <activity
            android:name=".ui.DoTuVungActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Man Le Hoa nhin lai viec minh da lam. -->
        <activity
            android:name=".ui.TienBoActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Bang gia gio choi: lam cai gi thi duoc may phut. -->
        <activity
            android:name=".ui.CachKiemGioActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- So con dung app gi, luc nao. exported=false: day la trang cua Ba Huy,
             nam sau PIN, khong mo bang adb hay shortcut duoc. -->
        <activity
            android:name=".ui.ThongKeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />


        <service
            android:name=".telegram.ApprovalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Giu ket noi cho phu huynh duyet va dem nguoc gio choi" />
        </service>

        <service
            android:name=".guard.GuardAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Ton tai de Android cho app hoi "app nao dang giu trinh phat". Tu 27/9/2026
             nhin them thong bao cua Telegram, chi ma khung chat va so tin, khong doc noi
             dung. Xem TrinhPhat.kt. -->
        <service
            android:name=".guard.TaiThongBao"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".guard.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
        </receiver>

        <receiver
            android:name=".guard.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".guard.Heartbeat$Receiver"
            android:exported="false" />

        <!-- Danh thuc dung gio di ngu va nua dem, de phieu duyet chua dung va bai
             dang cho duyet het han dung luc ma khong phai hoi vong. -->
        <receiver
            android:name=".guard.MocGio$Receiver"
            android:exported="false" />
    </application>
</manifest>
