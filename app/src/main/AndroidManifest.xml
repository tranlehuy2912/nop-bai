<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Chi de biet co mang hay khong, de chan nut Nop bai luc mat mang. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Chi de mo duoc hop thoai xin ra khoi danh sach tiet kiem pin. Nam trong
         danh sach do thi HyperOS dung tien trinh luc man hinh tat, va dich vu
         Telegram chet giua chung. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Du de liet ke app mo duoc tu man hinh chinh, khoi phai xin
         QUERY_ALL_PACKAGES von la quyen rong hon nhieu so voi viec can lam. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Phai khai bao rieng man hinh chinh va ban phim. Tu Android 11 app
             khong tu nhin thay app khac, thieu hai muc nay thi service coi man
             hinh chinh la app la va day no di, tablet thanh cuc gach. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeworkGate">

        <!-- Icon app tro vao day chu khong vao thang HomeActivity. App dang chay thi
             bam icon chi dua lai dung man dang mo, giong mo tu danh sach app gan day.
             Xem CuaVaoActivity. -->
        <activity
            android:name=".ui.CuaVaoActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mo app la vao thang man cua Le Hoa. Day la app quan ly con, con dung
             no moi ngay; phan cua Ba Huy nam sau mot nut chu nho o goc.
             singleTask de guard va man chan mo no la dong het man nam tren. Van
             exported: tools/web.py mo thang no bang adb. -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask" />

        <!-- exported=false de con khong mo thang bang adb hay shortcut. -->
        <activity
            android:name=".ui.ParentActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HomeworkGate.Camera" />

        <!-- Man con khai dang lam bai nao, di truoc man chup. -->
        <activity
            android:name=".ui.ChonBaiActivity"
            android:exported="false" />

        <!-- Man con soat lai ban may doc, di sau man chup. adjustResize de ban phim
             khong che mat dong dang sua.

             configChanges: xoay may thi man tu ve lai, Android khong dung lai no. Tablet
             cua Le Hoa bat tu xoay ma man chup khoa doc, nen chup xong hay xoay may. Dung
             lai man giua luc dang cham thi may cham lai tu dau, ton them mot luot AI, va
             nhung cau con vua bo ra cung mat. App khong co layout rieng cho chieu ngang
             nen tu ve lai khong mat gi. -->
        <activity
            android:name=".ui.SoatBaiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- exported=false de con khong mo thang bang adb hay shortcut. -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AppPickerActivity"
            android:exported="false" />

        <!-- adjustResize de ban phim khong che mat o go chu. -->
        <activity
            android:name=".ui.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.SoanActivity"
            android:exported="false" />

        <!-- configChanges cung ly do voi SoatBaiActivity. Dung lai man dan do thi mat tam
             anh vua chup va ban may vua doc, chua co ban luu thi camera bat lai ngay. -->
        <activity
            android:name=".ui.DanDoActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.TinActivity"
            android:exported="false" />

        <!-- Bai da cham: tung cau dung hay sai, sai thi may noi gi. Xem KetQuaActivity. -->
        <activity
            android:name=".ui.KetQuaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LichActivity"
            android:exported="false" />

        <!-- Hoc thuoc: may hoi, con go tra loi. adjustResize de ban phim khong che
             mat o go va thanh ky tu toan ngay duoi no. -->
        <activity
            android:name=".ui.HocThuocActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Do tu vung: may hoi mot tu, con tra loi. adjustResize cung mot le voi
             man tren - ban phim khong duoc che mat o go. -->
        <activity
            android:name=".ui.DoTuVungActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Man Le Hoa nhin lai viec minh da lam. -->
        <activity
            android:name=".ui.TienBoActivity"
            android:exported="false" />

        <!-- Bang gia gio choi: lam cai gi thi duoc may phut. -->
        <activity
            android:name=".ui.CachKiemGioActivity"
            android:exported="false" />

        <!-- So con dung app gi, luc nao. exported=false: day la trang cua Ba Huy,
             nam sau PIN, khong mo bang adb hay shortcut duoc. -->
        <activity
            android:name=".ui.ThongKeActivity"
            android:exported="false" />


        <service
            android:name=".telegram.ApprovalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Giu ket noi cho phu huynh duyet va dem nguoc gio choi" />
        </service>

        <service
            android:name=".guard.GuardAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Rong ruot: chi ton tai de Android cho app hoi "app nao dang giu trinh
             phat". Khong doc thong bao cua ai. Xem TrinhPhat.kt. -->
        <service
            android:name=".guard.TaiThongBao"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".guard.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
        </receiver>

        <receiver
            android:name=".guard.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".guard.Heartbeat$Receiver"
            android:exported="false" />

        <!-- Danh thuc dung gio di ngu va nua dem, de phieu duyet chua dung va bai
             dang cho duyet het han dung luc ma khong phai hoi vong. -->
        <receiver
            android:name=".guard.MocGio$Receiver"
            android:exported="false" />
    </application>
</manifest>
