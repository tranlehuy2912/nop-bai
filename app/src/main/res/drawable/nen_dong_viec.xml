<?xml version="1.0" encoding="utf-8"?>
<!-- Mot dong viec o man chinh (mau H, 16/11/2026): the trang bo 28dp, mep day xanh xam 7dp
     nhu phim noi. Dong co padding duoi lon hon tren 7dp cho phan mep nay. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#B8C8E6" />
        </shape>
    </item>
    <item android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
