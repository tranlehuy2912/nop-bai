<?xml version="1.0" encoding="utf-8"?>
<!-- Duong hoc thuoc: may hoi, con go thang o day, may cham ngay.
     Khong chup anh, khong goi AI - xem data/HocThuoc.kt.

     Mot layout cho ca ba buoc (chon bo, dang hoi, xong luot), bat tat bang
     visibility. Ba man rieng thi phai giu trang thai luot go qua lai giua chung,
     ma luot do song co vai phut roi bo. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/st_nen_man">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_thoat"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Quay lại"
            app:icon="@drawable/st_ic_quay_lai"
            app:iconSize="22dp"
            app:iconTint="@color/ink_soft" />

        <TextView
            android:id="@+id/txt_tieu_de"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hoc_thuoc_title"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BUOC 1: chon bo the. Cac dong do dung len trong ma nguon vi so bo
                 con doi theo tung nam hoc. -->
            <LinearLayout
                android:id="@+id/box_bo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txt_trong"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- BUOC 2: mot the dang hoi. -->
            <LinearLayout
                android:id="@+id/box_hoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_tien"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/txt_bai"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink_soft"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txt_hoi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/ink"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <EditText
                    android:id="@+id/o_go"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/hoc_thuoc_go"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <!-- Thanh ky tu, y het man soat bai: ban phim tablet khong co dau
                     mu, ma bat con di tim no thi thoi gian hoc thanh thoi gian tim
                     phim. Chi hien cho bo Toan va bo KHTN, moi mon mot bo nut. -->
                <HorizontalScrollView
                    android:id="@+id/dai_ky_tu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/nut_ky_tu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Khung ket qua, chi hien sau khi con bam Tra loi. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/the_ket"
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/txt_ket"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_dap"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cua thoat khi bi that.
                     Chi hien sau khi con da sai it nhat mot lan. Khong co nut nay thi
                     mot cau con khong go ra duoc se chan ca luot, va mot tuan nhu the
                     la con thoi mo app. Bam vao thi hien dap an, cau do bo khoi luot
                     va khong tinh phut - nhung mai no quay lai. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chiu"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/hoc_thuoc_chiu"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chinh"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- BUOC 3: xong luot. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/the_xong"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txt_xong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ok"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_xong_phu"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txt_chan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
