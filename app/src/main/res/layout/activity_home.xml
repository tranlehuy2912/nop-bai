<?xml version="1.0" encoding="utf-8"?>
<!--
  Man hinh Le Hoa nhin thay, bo cuc C cua mau H "Game bong bay" (anh Huy chon 16/11/2026).

  Ba tang, tu tren xuong:
   - GHIM TREN: dong ten va the trang thai. Anh Huy dan "phan card tren, va may nut o duoi
     phai co dinh, ko cho scroll". The co vong gio ben trai (dem nguoc phien, hay hinh trang
     thai khi khong co gi de dem), ben phai la nhan, chu to, thanh gio trong ngay va nut.
   - CUON: viec hom nay chia hai nhom "Làm ngay" va "Hằng ngày", moi viec mot the co o tich.
     Chi phan nay cuon, va chi cuon khi nhieu viec hon cho trong.
   - GHIM DUOI: thanh nut Nhan tin, Tin cua co, Thoi khoa bieu, Viec da lam, Cach kiem gio,
     Xem phim.

  Truoc 16/11/2026 ca man nay nam trong mot ScrollView va the trang thai nam giua, hang nut
  duoi cung bi khoi viec day xuong khuat khi viec nhieu.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/st_nen_man">

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="vertical"
    android:paddingTop="14dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <!-- ================= GHIM TREN ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="28dp">

        <TextView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/nut_tron_vang"
            android:fontFamily="@font/coiny"
            app:fontFamily="@font/coiny"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="Hòa"
            android:textColor="@android:color/white"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/coiny"
                app:fontFamily="@font/coiny"
                android:text="@string/child_name"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/txt_ngay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Duong vao phan cua Ba Huy: co mat nhung khong tranh cho voi noi dung cua Le Hoa. -->
        <ImageButton
            android:id="@+id/btn_parent"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nut_tron_vang"
            android:contentDescription="@string/parent_name_cap"
            android:paddingBottom="16dp"
            android:paddingTop="12dp"
            android:paddingHorizontal="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_khoa"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- The trang thai. Nen (vien day theo mau trang thai, mep day dam) dat trong code, xem
         HomeActivity.doiMat. Padding duoi lon hon tren 12dp cho phan mep day. -->
    <LinearLayout
        android:id="@+id/card_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="26dp"
        android:paddingTop="24dp"
        android:paddingEnd="26dp"
        android:paddingBottom="36dp">

        <!-- Vong gio ben trai. Dang choi, tam dung: vong vo dan theo phut con lai, giua la
             dong ho. Da duyet chua bam choi: vong day, giua la so phut. Con lai: vong rong,
             giua la hinh tron bong cua trang thai. -->
        <FrameLayout
            android:id="@+id/khung_vong"
            android:layout_width="224dp"
            android:layout_height="224dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/vong_phien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:indicatorSize="220dp"
                app:trackColor="#E9EEF8"
                app:trackCornerRadius="10dp"
                app:trackThickness="20dp" />

            <ImageView
                android:id="@+id/anh_mat"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:paddingStart="28dp"
                android:paddingTop="26dp"
                android:paddingEnd="28dp"
                android:paddingBottom="30dp" />

            <LinearLayout
                android:id="@+id/giua_vong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <vn.huytl.homeworkgate.ui.ChuVien
                    android:id="@+id/txt_vong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/coiny"
                    app:fontFamily="@font/coiny"
                    android:fontFeatureSettings="tnum"
                    android:paddingHorizontal="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@android:color/white"
                    android:textSize="46sp" />

                <TextView
                    android:id="@+id/txt_vong_duoi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_soft"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/cot_phai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/coiny"
                app:fontFamily="@font/coiny"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="24dp"
                android:paddingBottom="10dp"
                android:shadowColor="#33000000"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:textColor="@android:color/white"
                android:textSize="19sp" />

            <vn.huytl.homeworkgate.ui.ChuVien
                android:id="@+id/txt_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/coiny"
                app:fontFamily="@font/coiny"
                android:paddingHorizontal="6dp"
                android:paddingBottom="8dp"
                android:textColor="@android:color/white"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/txt_detail"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <!-- Han muc gio choi hom nay: ba khuc tren mot thanh, xem ThanhNgay. Khong bam duoc nua
                 tu 16/11/2026 (bo man Cach kiem gio khoi man chinh). -->
            <LinearLayout
                android:id="@+id/khung_han_ngay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/khung_thanh"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:background="@drawable/nen_thanh_ngay_h"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <View
                        android:id="@+id/phan_da_choi"
                        android:layout_width="0dp"
                        android:layout_height="match_parent" />

                    <View
                        android:id="@+id/phan_dang_giu"
                        android:layout_width="0dp"
                        android:layout_height="match_parent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chu_han_ngay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nut viec chinh, chu va mau doi theo trang thai, xem HomeActivity.render. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                style="@style/Nut.Bong"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="16dp"
                android:text="@string/home_submit"
                android:textSize="22sp" />

            <!-- Nut phu: Huy bai vua nop, hay nop them bai. An khi tat "Nop bai bang anh". -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_nop_them"
                style="@style/Nut.Bong.Trang"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="Nộp thêm bài để cộng dồn giờ"
                android:textSize="17sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= CUON ================= -->

    <ScrollView
        android:id="@+id/cuon_viec"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="26dp"
        android:paddingHorizontal="28dp"
        android:paddingBottom="8dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/nhan_lam_ngay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/coiny"
                    app:fontFamily="@font/coiny"
                    android:text="Làm ngay"
                    android:textColor="@color/ink"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/dem_lam_ngay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/nen_dem_do"
                    android:fontFamily="@font/coiny"
                    app:fontFamily="@font/coiny"
                    android:minWidth="32dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="3dp"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/box_lam_ngay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/nhan_hang_ngay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/coiny"
                    app:fontFamily="@font/coiny"
                    android:text="Hằng ngày"
                    android:textColor="@color/ink"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/dem_hang_ngay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/nen_dem_xanh"
                    android:fontFamily="@font/coiny"
                    app:fontFamily="@font/coiny"
                    android:minWidth="32dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="3dp"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/box_hang_ngay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- ================= GHIM DUOI ================= -->

    <!-- Cac duong phu. Nut nhan tin khong bao gio bi khoa theo gio choi: con phai bao duoc
         mot viec gap ke ca luc dang bi cam choi. Tin moi hien thanh cham do co so tren nut
         (16/11/2026), thay cho doi chu nut thanh "Ba Huy nhắn N tin mới". -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/nen_thanh_duoi"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="18dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/btn_chat"
                style="@style/O.ThanhDuoi">

                <ImageView
                    android:id="@+id/hinh_chat"
                    style="@style/O.ThanhDuoi.Hinh"
                    android:src="@drawable/st_ic_nhan_tin" />

                <TextView
                    style="@style/O.ThanhDuoi.Chu"
                    android:text="@string/home_chat" />
            </LinearLayout>

            <TextView
                android:id="@+id/huy_hieu_chat"
                style="@style/O.ThanhDuoi.HuyHieu" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/o_tin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btn_tin"
                style="@style/O.ThanhDuoi">

                <ImageView
                    android:id="@+id/hinh_tin"
                    style="@style/O.ThanhDuoi.Hinh"
                    android:src="@drawable/st_ic_tin_co" />

                <TextView
                    style="@style/O.ThanhDuoi.Chu"
                    android:text="@string/soan_tin_co" />
            </LinearLayout>

            <TextView
                android:id="@+id/huy_hieu_tin"
                style="@style/O.ThanhDuoi.HuyHieu" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/btn_lich"
                style="@style/O.ThanhDuoi">

                <ImageView
                    android:id="@+id/hinh_lich"
                    style="@style/O.ThanhDuoi.Hinh"
                    android:src="@drawable/st_ic_lich" />

                <TextView
                    style="@style/O.ThanhDuoi.Chu"
                    android:text="@string/soan_lich" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/btn_tien_bo"
                style="@style/O.ThanhDuoi">

                <ImageView
                    android:id="@+id/hinh_tien_bo"
                    style="@style/O.ThanhDuoi.Hinh"
                    android:src="@drawable/st_ic_tien_bo" />

                <TextView
                    style="@style/O.ThanhDuoi.Chu"
                    android:text="@string/tien_bo_nut" />
            </LinearLayout>
        </FrameLayout>

        <!-- O "Cách kiếm giờ" bo ngay 16/11/2026 (anh Huy dan "bỏ tab cách kiếm giờ"), cung
             voi duong bam vao thanh gio trong the. Man CachKiemGioActivity van giu code. -->

        <!-- Doi phut choi sang phut xem phim tren laptop: chi hien khi laptop da noi vao nha,
             xem dongbo/Laptop. -->
        <FrameLayout
            android:id="@+id/o_xem_phim"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btn_xem_phim"
                style="@style/O.ThanhDuoi">

                <ImageView
                    android:id="@+id/hinh_xem_phim"
                    style="@style/O.ThanhDuoi.Hinh"
                    android:src="@drawable/st_ic_phim" />

                <TextView
                    style="@style/O.ThanhDuoi.Chu"
                    android:text="@string/xem_phim_nut" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
