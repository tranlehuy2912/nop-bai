<?xml version="1.0" encoding="utf-8"?>
<!-- Man hinh Le Hoa nhin thay. Mot the trang thai to o giua, mot nut to o duoi.
     Khong co nut nao khac: moi nut them vao day deu la mot thu de bam thu. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/st_nen_man">

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="vertical"
    android:padding="28dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_child"
            android:gravity="center"
            android:text="Hòa"
            android:textColor="@color/child_tint"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/child_name"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Duong vao phan cua Ba Huy: co mat nhung khong tranh cho voi noi dung
             cua Le Hoa. Truoc day hai nguoi chia doi man hinh dau tien 50/50, trong
             khi con dung app nay moi ngay con Ba Huy thi dieu khien qua Telegram la
             chinh. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_parent"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/parent_name_cap"
            app:icon="@drawable/ic_khoa"
            app:iconSize="22dp"
            app:iconTint="@color/ink_soft" />
    </LinearLayout>

    <!-- Cuon duoc phan than.
         Truoc day man nay khong cuon: noi dung vua dung mot man hinh nen khong ai
         nghi toi. Nhung so the o giua thay doi theo trang thai - the "con cau can
         sua", the soan cap - va du ca hai cung hien mot luc thi nut Nop bai bi
         day khuat khoi day man hinh, khong co cach nao voi toi.
         fillViewport de hai o Space ben duoi van an het cho thua khi noi dung ngan,
         tuc la luc binh thuong the trang thai van nam giua nhu cu. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Khoang trong tren va duoi de the trang thai nam giua phan con lai, thay vi
         keo the cao het man hinh roi de trong. Tren tablet 11 inch, mot the trang
         cao gan met ma chi co ba dong chu o giua nhin rat trong. -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_state"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <!-- Hinh to o tren cung. Doc chu "Dang khoa" voi "Dang duoc choi" thi
                 phai nhin ky moi khac nhau; o khoa voi tay cam thi liec mot cai la
                 biet, ke ca khi de may o dau ban.

                 Icon ve tay chu khong phai emoji: emoji ve theo bo font cua may,
                 tren HyperOS ra mot kieu khac han va khong an voi bang mau o day.
                 Hinh nay do lai theo dung mau cua tung trang thai, xem doiMat(). -->
            <ImageView
                android:id="@+id/anh_mat"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/txt_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:textColor="@color/brand_dark"
                android:textSize="15sp" />

            <!-- Dong ho dem nguoc, chi hien luc dang choi hay dang tam dung.
                 Mot day so "12:34" khong noi duoc con nhieu hay sap het; vong tron
                 voi dan quanh no thi noi duoc bang mot cai liec, tu xa cung thay. -->
            <FrameLayout
                android:id="@+id/khung_vong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/vong_phien"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:indicatorSize="196dp"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="12dp" />

                <TextView
                    android:id="@+id/txt_vong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                style="@style/Text.Body" />

            <!-- Han muc gio choi hom nay, ve thanh mot thanh chu khong phai mot cau.
                 Ba phan tren cung mot truc la tran cua ngay: phan da choi, phan da
                 kiem duoc ma chua choi, va phan con co the kiem them. Doc mot cau
                 "da duoc 50 phut, toi da 120" thi phai tinh nham; nhin thanh nay thi
                 biet ngay hom nay con nhieu hay sap het. -->
            <LinearLayout
                android:id="@+id/khung_han_ngay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:background="@drawable/st_nen_thanh_ngay"
                    android:clipToOutline="true"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/phan_da_choi"
                        android:layout_width="0dp"
                        android:layout_height="match_parent" />

                    <View
                        android:id="@+id/phan_dang_giu"
                        android:layout_width="0dp"
                        android:layout_height="match_parent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chu_han_ngay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Viec hom nay: on lai, soan cap, hoc thuoc, chup lai cau da sua.

         Bon viec nay truoc day la bon the rieng, moi the mot nut ben trong. Cong
         voi nut Nop bai va hang duoi cung thi man hinh cua mot dua tre lop tam co
         gan chuc cho de bam. Gom lai mot khoi, moi viec mot dong bam duoc, va man
         hinh chi con dung mot nut to. -->
    <TextView
        android:id="@+id/nhan_viec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.08"
        android:text="VIỆC HÔM NAY"
        android:textColor="@color/ink_soft"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_viec"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/box_viec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_marginTop="20dp"
        android:text="@string/home_submit"
        android:textSize="24sp"
        app:cornerRadius="28dp" />

    <!-- Nop them bai de cong don gio. Chi hien khi dang giu mot phieu chua dung:
         luc do nut to o tren la "Bat dau choi", khong con cho nao de nop them. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_nop_them"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Nộp thêm bài để cộng dồn giờ"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Cac duong phu, gom vao mot khu rieng.

         Truoc day chung xep doc duoi nut Nop bai, moi cai mot kieu - mot tonal,
         hai text - nhin nhu mot chong nut roi ra chu khong phai mot nhom. Gio cung
         mot the, cung co chu, cung co icon, chia deu: nut to o tren la viec dang
         phai lam, con day la may cho de di xem.

         Nut nhan tin khong bao gio bi khoa theo gio choi: con phai bao duoc mot
         viec gap ke ca luc dang bi cam choi. -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chat"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="18dp"
                android:text="@string/home_chat"
                android:textSize="15sp"
                app:icon="@drawable/st_ic_nhan_tin"
                app:iconGravity="top"
                app:iconPadding="6dp"
                app:iconSize="24dp" />

            <!-- Vach nay an/hien cung nut Tin cua co. Khong buoc vao nhau thi luc
                 khong co tin, hai vach hai ben nut do chong len nhau o giua the. -->
            <View
                android:id="@+id/vach_tin"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/line" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tin"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="18dp"
                android:text="@string/soan_tin_co"
                android:textSize="15sp"
                app:icon="@drawable/st_ic_tin_co"
                app:iconGravity="top"
                app:iconPadding="6dp"
                app:iconSize="24dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/line" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lich"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="18dp"
                android:text="@string/soan_lich"
                android:textSize="15sp"
                app:icon="@drawable/st_ic_lich"
                app:iconGravity="top"
                app:iconPadding="6dp"
                app:iconSize="24dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/line" />

            <!-- Duong vao man Le Hoa nhin lai viec minh da lam. De o hang nay chu
                 khong giau sau mot man khac: cai gi con khong thay thi khong co. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tien_bo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="18dp"
                android:text="@string/tien_bo_nut"
                android:textSize="15sp"
                app:icon="@drawable/st_ic_tien_bo"
                app:iconGravity="top"
                app:iconPadding="6dp"
                app:iconSize="24dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/line" />

            <!-- Bang gia gio choi. Thanh han muc o the tren cung mo dung man nay,
                 nhung mot thanh mau bam duoc thi khong dua tre nao doan ra; cho
                 nao con tim duoc bang mat phai co ten. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_kiem_gio"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="18dp"
                android:text="@string/kiem_gio_nut"
                android:textSize="15sp"
                app:icon="@drawable/st_ic_dong_ho"
                app:iconGravity="top"
                app:iconPadding="6dp"
                app:iconSize="24dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    </LinearLayout>
    </ScrollView>
</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
