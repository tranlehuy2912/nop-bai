<?xml version="1.0" encoding="utf-8"?>
<!--
  Tiet kiem pin khi man hinh tat (5/11/2026), xem pin/TietKiemPin.kt. Cung cac muc voi nhom
  "Tiết kiệm pin" o the Cai dat cua Bang dieu khien: anh Huy muon chinh duoc ngay tren tablet,
  phong khi mat dien thoai. Doi muc nao la luu ngay, khong co nut Luu.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:text="Tiết kiệm pin"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_bat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tự động tiết kiệm pin" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tắt màn hình đủ số phút chọn dưới đây thì máy tiết kiệm pin. Mở màn hình lên là máy dùng như thường. Đang cắm sạc thì không làm gì."
                            android:textColor="@color/ink_soft"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Bật Tiết kiệm pin của máy sau"
                            android:textColor="@color/ink"
                            android:textSize="15sp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/nhom_phut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:selectionRequired="true"
                            app:singleSelection="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Tạm dừng app sau"
                            android:textColor="@color/ink"
                            android:textSize="15sp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/nhom_phut_dung"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:selectionRequired="true"
                            app:singleSelection="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_chon_app"
                            style="@style/Nut.Vien"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="App tạm dừng thì xám đi, không chạy nền, không báo tin. Mở màn hình là dùng lại được ngay, nhưng tin đến trong lúc dừng không có thông báo bù."
                            android:textColor="@color/ink_soft"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hai thu tiet kiem pin can: quyen ghi cai dat he thong va Jokers Permissions.
                     Thieu thu nao thi the nay noi ro va co nut sua neu sua duoc ngay tren may. -->
                <TextView
                    style="@style/Nhan.Nhom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TÌNH TRẠNG" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/txt_tinh_trang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_jokers"
                            style="@style/Nut.Vien"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
