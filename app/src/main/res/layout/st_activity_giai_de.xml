<?xml version="1.0" encoding="utf-8"?>
<!--
  Man Giai de: mot de may ra tu sach bai tap, Le Hoa lam mot mach co dong ho.

  Ca de nam trong mot danh sach cuon: the huong dan truoc khi bat dau, roi tung cau,
  roi nut Nop bai o cuoi danh sach, sat cau cuoi cung. Khong co thanh nut to dinh o day
  man hinh (Ba Huy gop y ngay 27/9/2026: nut nen vua co va nam sat phan no tac dong).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/st_nen_man">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/st_le_ngang">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_quay_lai"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Quay lại"
                app:icon="@drawable/st_ic_quay_lai"
                app:iconSize="22dp"
                app:iconTint="@color/ink_soft" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Dong ho: con lai bao nhieu, het gio thi chuyen do va dem so phut qua. -->
            <TextView
                android:id="@+id/dong_ho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="@color/brand_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tieu_de"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="@dimen/st_le_ngang"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phu_de"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="@dimen/st_le_ngang"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <ScrollView
            android:id="@+id/khung_cuon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/danh_sach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/st_le_ngang"
                android:paddingTop="14dp"
                android:paddingBottom="28dp" />
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
