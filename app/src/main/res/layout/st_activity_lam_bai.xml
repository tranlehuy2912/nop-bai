<?xml version="1.0" encoding="utf-8"?>
<!--
  Man lam bai tren may: moi lan mot cau, sao o goc tren, khung ghep ngay duoi de bai.

  Nut Kiem tra va Cau tiep nam cuoi danh sach cuon, sat khung ghep (cung le voi man Giai
  de: nut nam sat phan no tac dong). Luc dang lam, canh Kiem tra co nut vien "Bài này làm sau" de bo
  qua cau chua lam duoc (Ba Huy chot 30/9/2026, ten nut doi tu "Câu tiếp" ngay 2/10/2026); lam xong
  thi hai nut do an, hien nut Câu tiếp dac. Khong co chu nao giai thich luat sao - Ba Huy chot
  ngay 29/9/2026 de con tu kham pha. Chu duy nhat canh sao la dong "Lần trước" khi lam lai
  (Ba Huy dong y ngay 30/9/2026): do la thong tin, khong phai loi giai thich luat.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/st_nen_man">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/st_le_ngang">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_quay_lai"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Quay lại"
                app:icon="@drawable/st_ic_quay_lai"
                app:iconSize="22dp"
                app:iconTint="@color/ink_soft" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Sao cua cau dang lam, ba dang: rong la con co the duoc, xam la da mat vi sai,
                 vang la da duoc. Mau tung sao ve bang span, xem HangSao. Duoi la dong "Lần
                 trước" (sao tot nhat cua vong nay), chi hien khi lam lai. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/wait"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/sao_truoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_soft"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tieu_de"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="@dimen/st_le_ngang"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phu_de"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="@dimen/st_le_ngang"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <!-- Dong nho "Đại số: đã làm 12/155 câu" khi luyen tap (Ba Huy chot 2/10/2026): con biet
             ca phan con bao nhieu cau, ngoai "Câu 3/10" cua luot. Dem tren ca phan, ke ca bai
             chua hoc, cung so voi dong Luyen tap o trang Luyen tap. -->
        <TextView
            android:id="@+id/tong_phan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="@dimen/st_le_ngang"
            android:textColor="@color/ink_soft"
            android:textSize="13sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/khung_cuon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/st_le_ngang"
                android:paddingTop="14dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:id="@+id/de"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/khung"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nut_kiem"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:text="Kiểm tra"
                        android:textSize="18sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nut_bo_qua"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:text="Bài này làm sau"
                        android:textSize="18sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nut_tiep"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:text="Câu tiếp"
                        android:textSize="18sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/ket"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
