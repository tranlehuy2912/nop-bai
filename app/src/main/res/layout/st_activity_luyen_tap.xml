<?xml version="1.0" encoding="utf-8"?>
<!--
  Trang Luyen tap, phuong an B cua mau H "Game bong bay" (anh Huy chon 16/11/2026).

  GHIM TREN: nut quay lai tron vang, tieu de, hang nut mon (Toan, KHTN, Tieng Anh, Ngu van; mon
  dang chon dam mau, mon khac nhat), va nut nho "Bai da hoc" cua mon dang chon.
  CUON: viec cua mon dang chon, chia nhom "Hôm nay" (On tap, Kiem tra, de on), "Luyện tập" (SGK,
  tung phan, Cau da lam dung), "Đề thi thử" (bon ky). Moi viec la mot o mau cua mon, ba cot (de
  thi bon cot), co so "da lam / tong" va thanh tien do trang. O ve trong code, xem LuyenTapActivity.

  Truoc 16/11/2026 trang nay xep ca bon mon thanh bon khu doc mot trang, khoang 38 dong.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/st_nen_man">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="14dp">

            <ImageButton
                android:id="@+id/nut_quay_lai"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/nut_tron_vang"
                android:contentDescription="Quay lại"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/st_ic_quay_lai"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/coiny"
                android:text="Luyện tập"
                android:textColor="@color/ink"
                android:textSize="30sp"
                app:fontFamily="@font/coiny" />
        </LinearLayout>

        <!-- Hang nut mon. Nut them trong code, moi mon mot mau (MatMon). -->
        <LinearLayout
            android:id="@+id/hang_mon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingHorizontal="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bài đã học"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Thay cho dong "Bài đã học" dung dau moi khu truoc 16/11/2026: bam la hop danh dau
                 bai cua mon dang chon (ChonHocToi). -->
            <TextView
                android:id="@+id/nut_da_hoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/nen_dong_viec"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadingEdgeLength="26dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/box_mon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="4dp"
                android:paddingBottom="28dp" />
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
