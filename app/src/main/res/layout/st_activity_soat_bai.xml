<?xml version="1.0" encoding="utf-8"?>
<!--
  Man con soat lai ban may doc, truoc khi bai di den tay Ba Huy.

  Man nay KHONG hien dung hay sai. No hoi dung mot cau: may doc co ra dung chu con
  viet khong. Con thay may doc nham thi sua ngay dong do; con tu nhin lai ma thay
  minh lam sai thi bo cau do ra, sua trong vo roi nop lai - viet lai bang tay moi
  vao dau, go vao may thi khong.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/st_be_rong_toi_da">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nut_quay_lai"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:contentDescription="Quay lại"
            app:icon="@drawable/st_ic_quay_lai"
            app:iconSize="22dp"
            app:iconTint="@color/ink_soft" />

        <TextView
            android:id="@+id/tieu_de"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/st_le_ngang"
            android:text="Máy đọc bài con thế này"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phu_de"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="@dimen/st_le_ngang"
            android:text="Xem có đúng chữ con viết không. Máy đọc sai thì sửa lại."
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <!-- Luc dang goi AI. Che ca phan duoi, vi chua co gi de xem. -->
        <LinearLayout
            android:id="@+id/khung_cho"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/brand" />

            <TextView
                android:id="@+id/chu_cho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Đang đọc bài của con…"
                android:textColor="@color/ink_soft"
                android:textSize="16sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/khung_cuon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/danh_sach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/st_le_ngang"
                android:paddingTop="12dp"
                android:paddingBottom="20dp" />
        </ScrollView>

        <!-- Dai nut toan. Chi hien khi con dang go vao mot dong. -->
        <HorizontalScrollView
            android:id="@+id/dai_toan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_soft"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/nut_toan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/day_nut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/st_le_ngang"
            android:paddingTop="10dp"
            android:paddingBottom="22dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/dem_cau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_gui"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Gửi cho Ba Huy"
                android:textSize="18sp"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_chup_lai"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Chụp lại cả bài"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
