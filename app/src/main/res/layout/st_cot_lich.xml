<?xml version="1.0" encoding="utf-8"?>
<!-- Mot cot cua luoi: dau cot la ten thu, duoi la cac o tiet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/dau_cot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/st_cao_dau_cot"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/nhan_thu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:textColor="@color/brand_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nhan_ngay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/danh_sach_o"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
