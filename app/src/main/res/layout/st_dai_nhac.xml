<?xml version="1.0" encoding="utf-8"?>
<!-- The nho neo goc tren ben trai. Khong keo het be ngang nua: mot dai chan ca
     mep tren trong nhu loi he thong va che mat thanh trang thai. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/dai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/st_nen_the_nhac"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:minWidth="300dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="20dp"
        android:paddingBottom="13dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/st_nen_vong_icon">

            <ImageView
                android:id="@+id/bieu_tuong"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/st_ic_cap_sach"
                app:tint="@color/st_the_nhac_chu" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:maxWidth="330dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tieu_de"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="330dp"
                android:textColor="@color/st_the_nhac_chu"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chi_tiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxWidth="330dp"
                android:textColor="@color/st_the_nhac_chu_mo"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nut_mo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/st_nen_nut_mo"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="Mở"
            android:textColor="@color/st_the_nhac_chu"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
