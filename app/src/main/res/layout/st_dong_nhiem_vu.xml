<?xml version="1.0" encoding="utf-8"?>
<!--
  Mot viec trong danh sach o man chinh, bo cuc C cua mau H (16/11/2026): o tich ben trai (xong
  thi thanh dau tich xanh), hinh tron bong mau rieng cua viec, ten va dong phu, nut tron vang
  co mui ten ben phai. Ca dong bam duoc.

  Trang Luyen tap van dung st_dong_viec.xml (co o so "da lam / tong").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/nen_dong_viec"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="86dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="19dp">

    <ImageView
        android:id="@+id/o_tich"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@null"
        android:padding="7dp" />

    <ImageView
        android:id="@+id/hinh"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginStart="14dp"
        android:contentDescription="@null"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        app:tint="@android:color/white" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_soft"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mui"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/nut_tron_vang"
        android:contentDescription="@null"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp"
        android:src="@drawable/st_ic_mui_phai" />
</LinearLayout>
