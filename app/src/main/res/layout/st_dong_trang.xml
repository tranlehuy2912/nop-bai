<?xml version="1.0" encoding="utf-8"?>
<!--
  Mot trang sach de tich.

  Truoc day la mot o tich voi hai dong chu "Trang 6 · 1 cau / Bai 1. Don thuc". Tam
  muoi ba dong nhu vay lien nhau thi so trang - thu duy nhat co giao doc len - chim
  lan giua chu. Gio no nam trong mot o vuong rieng, doc duoc tu xa.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="6dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/o_tich"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/so_trang"
        android:layout_width="52dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/st_nen_huy_hieu_vuong"
        android:gravity="center"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ten_bai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/so_cau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
