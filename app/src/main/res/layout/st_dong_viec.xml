<?xml version="1.0" encoding="utf-8"?>
<!--
  Mot viec trong danh sach "Viec hom nay" o man hinh chinh.

  Truoc day moi viec la mot the rieng kem mot nut ben trong: on lai, soan cap, hoc
  thuoc, chup lai cau da sua. Bon the va bon nut, cong nut Nop bai va hang duoi
  cung, thanh ra man hinh cua mot dua tre lop tam co gan chuc cho de bam. Gio moi
  viec la mot dong, bam ca dong, va khong con nut nao trong do.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/hinh"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/st_nen_huy_hieu"
        android:contentDescription="@null"
        android:padding="11dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/duoi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/ink_soft"
        android:textSize="22sp" />
</LinearLayout>
