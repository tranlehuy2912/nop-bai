<?xml version="1.0" encoding="utf-8"?>
<!--
  Mot o o trang Luyen tap (phuong an B cua mau H, 16/11/2026): o mau cua mon, vien trang, mep
  day dam. Trong o: bieu tuong tren nen trang trong cung dong voi ten, dong phu, thanh tien do trang va so
  "da lam / tong". O da xong hom nay co dau tich xanh o goc. Nen ve trong code (HinhBong.o).
  FrameLayout ngoai de dau tich tran ra ngoai goc o.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="12dp"
    android:paddingEnd="10dp">

    <!-- Cao bang o cao nhat cua hang: hang la LinearLayout ngang cao wrap_content, con
         match_parent thi no do lai cho moi o cung mot chieu cao. -->
    <LinearLayout
        android:id="@+id/than"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:minHeight="110dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="23dp">

        <!-- Bieu tuong va ten cung mot dong (anh Huy dan 16/11/2026 "cho tieu de o tren dong voi
             icon"); truoc do bieu tuong o tren, ten o duoi cach mot khoang trong. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hinh"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/nen_o_hinh"
                android:contentDescription="@null"
                android:padding="12dp"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/ten"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/baloo2_rat_dam"
                android:lineSpacingMultiplier="0.9"
                android:shadowColor="#33000000"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                app:fontFamily="@font/baloo2_rat_dam" />
        </LinearLayout>

        <TextView
            android:id="@+id/phu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <LinearLayout
            android:id="@+id/khung_tien_do"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/thanh"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1"
                android:background="@drawable/nen_thanh_o"
                android:orientation="horizontal">

                <View
                    android:id="@+id/phan_lam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/nen_phan_o" />
            </LinearLayout>

            <TextView
                android:id="@+id/so"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/dau_xong"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-12dp"
        android:layout_marginEnd="-10dp"
        android:background="@drawable/nen_dau_xong"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/st_ic_tich"
        android:visibility="gone" />
</FrameLayout>
