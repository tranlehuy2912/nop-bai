<?xml version="1.0" encoding="utf-8"?>
<!--
  Mot cau trong de Giai de: nhan, de bai, hang bon chu (chi cau trac nghiem), va dong
  ket qua sau khi nop. Bon chu la nut vua tay, khong phai o tich: con bam mot chu, bam
  lai dung chu do la bo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/st_nen_the"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/nhan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_soft"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/de"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/ink"
        android:textIsSelectable="false"
        android:textSize="17sp" />

    <LinearLayout
        android:id="@+id/hang_chu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
