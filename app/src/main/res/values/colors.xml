<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Hai mau chinh: xanh la cho luc duoc choi, cam cho luc dang khoa.
         Tranh mau do vi man hinh khoa hien ca buoi toi, do nhin lau thay gat.
         Tu 16/11/2026 ca bang mau theo mau H "Game bong bay" anh Huy chon: xanh duong, xanh
         la, cam, vang tuoi hon; chu xanh muc #24305E thay cho den xam. Cam khoa dam hon cam
         cua mau (#FF8A3D) vi con dung lam mau chu tren nen cam nhat. -->
    <color name="brand">#3D8BFF</color>
    <color name="brand_dark">#1F5FCC</color>
    <color name="brand_soft">#E3EEFF</color>

    <color name="ok">#1FA347</color>
    <color name="ok_soft">#DDF7E3</color>

    <color name="wait">#FFB300</color>
    <color name="wait_soft">#FFF3CC</color>

    <color name="locked">#E8681A</color>
    <color name="locked_soft">#FFE9D9</color>

    <!-- Do chi danh cho bang canh bao cua Ba Huy, khong dung o man cua Le Hoa:
         cai bang do phai doi mau khi may dang ho, khong thi nhin mai thanh quen. -->
    <color name="alert">#F0445A</color>
    <color name="alert_soft">#FFE3E7</color>

    <color name="ink">#24305E</color>
    <color name="ink_soft">#5D6A94</color>
    <color name="surface">#FFFFFF</color>
    <color name="canvas">#DDF2FF</color>
    <color name="line">#E2E9F6</color>
    <!-- Sao da mat vi sai o bai lam tren may (HangSao): xam dac, dam hon `line` mot chut de
         con van dem duoc so o, nhung khong lan voi sao rong con co the duoc. -->
    <color name="sao_mat">#C5CAD3</color>
    <!-- Hai khuc cua thanh han muc ngay (ThanhNgay). Ba Huy chot ba mau co dinh ngay 1/10/2026:
         trang (nen) la tong co the co, xam nhat la phut da kiem ma chua choi, xanh duong la
         phut da choi. Khong doi theo trang thai cong.
         Truoc do khuc da choi tung la xanh la (trung mau phan CON LAI cua vong dem nguoc),
         roi xam dam #B4BAC4 kem khuc dang giu doi mau theo trang thai. -->
    <color name="da_choi">@color/brand</color>
    <color name="con_giu">#C9CFD8</color>

    <!--
      Mau cua tung mon hoc.

      Moi mon mot mau va mot chu viet tat, dung lai o moi cho co ten mon: man chon
      mon, danh sach bai, nhat ky, bang thong ke. Truoc day chin mon la chin o chu
      nhat giong het nhau, phan biet bang chu - Toan voi Ngu van nhin y nhau, phai
      doc moi biet. Co mau thi con quen tay, nhin mot cai la bam dung.

      Bay mau du cho mot thoi khoa bieu: hon the thi hai mon ke nhau bat dau lan.
    -->
    <color name="mon_1">#2F6FED</color>
    <color name="mon_1_nen">#E8F0FE</color>
    <color name="mon_2">#1E8E3E</color>
    <color name="mon_2_nen">#E6F4EA</color>
    <color name="mon_3">#C2591A</color>
    <color name="mon_3_nen">#FBEDE3</color>
    <color name="mon_4">#7B3FBF</color>
    <color name="mon_4_nen">#F0E9FA</color>
    <color name="mon_5">#0F8A8A</color>
    <color name="mon_5_nen">#E3F5F5</color>
    <color name="mon_6">#B03060</color>
    <color name="mon_6_nen">#FAE8EF</color>
    <color name="mon_7">#5C6BC0</color>
    <color name="mon_7_nen">#EAECF9</color>

    <!-- Mau cho hai nguoi dung, de phan biet ngay tu xa. -->
    <color name="parent_tint">#5B4BC4</color>
    <color name="parent_soft">#EDEAFB</color>
    <color name="child_tint">#0F8A8A</color>
    <color name="child_soft">#E3F5F5</color>

    <!-- Phan soan tap vo. Man hinh trong app dung chung bang mau o tren; rieng hai
         lop phu thi giu bang mau nay, vi chung nam de len app khac chu khong nam
         trong app. Nen dam de khong lan voi giao dien ben duoi, va de liec mot cai
         la biet day la app minh chu khong phai thong bao cua game.

         The nhac tach lam hai tong: xanh muc cho viec thuong, cam gach cho viec
         gap, de biet cai nao phai lam ngay ma khong can doc chu.
         Tu 16/11/2026 hai lop phu nay dung ban toi cua mau H (troi dem tim xanh), anh Huy
         chon: van dam de noi tren app khac, nhung cung mot bo voi phan con lai. -->
    <color name="st_the_nhac_nen">#2A2A6E</color>
    <color name="st_the_nhac_nen_gap">#E8590C</color>
    <color name="st_the_nhac_chu">#FFFFFF</color>
    <color name="st_the_nhac_chu_mo">#C7C4F0</color>
    <color name="st_the_nhac_chu_mo_gap">#FFE0CC</color>

    <!-- Man chan gio di hoc: che kin man hinh nen khong can hoa voi gi ca, va nen
         dam thi do choi mat hon mot mang trang giua buoi sang. -->
    <color name="st_nen_chan">#FF16173F</color>
    <color name="st_chu_chan">#FFFFFF</color>
    <color name="st_chu_chan_mo">#B3B0E0</color>
    <color name="st_chu_chan_nhan">#FFC93C</color>
    <color name="st_vien_chan">#40FFFFFF</color>

    <!-- Net ke luoi thoi khoa bieu. Dam hon @color/line mot chut: net dut mong hon
         net lien nhieu, dung dung mot mau thi nhin nhu khong co. -->
    <color name="st_ke_luoi">#C8D0DC</color>

    <!-- Mau H "Game bong bay" (anh Huy chon 16/11/2026, chi ban sang). Troi o dau va duoi man
