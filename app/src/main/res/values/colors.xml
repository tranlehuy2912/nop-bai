    <!--
      Mau cua tung mon hoc.

      Moi mon mot mau va mot chu viet tat, dung lai o moi cho co ten mon: man chon
      mon, danh sach bai, nhat ky, bang thong ke. Truoc day chin mon la chin o chu
      nhat giong het nhau, phan biet bang chu - Toan voi Ngu van nhin y nhau, phai
      doc moi biet. Co mau thi con quen tay, nhin mot cai la bam dung.

      Bay mau du cho mot thoi khoa bieu: hon the thi hai mon ke nhau bat dau lan.
    -->
    <color name="mon_1">#2F6FED</color>
    <color name="mon_1_nen">#E8F0FE</color>
    <color name="mon_2">#1E8E3E</color>
    <color name="mon_2_nen">#E6F4EA</color>
    <color name="mon_3">#C2591A</color>
    <color name="mon_3_nen">#FBEDE3</color>
    <color name="mon_4">#7B3FBF</color>
    <color name="mon_4_nen">#F0E9FA</color>
    <color name="mon_5">#0F8A8A</color>
    <color name="mon_5_nen">#E3F5F5</color>
    <color name="mon_6">#B03060</color>
    <color name="mon_6_nen">#FAE8EF</color>
    <color name="mon_7">#5C6BC0</color>
    <color name="mon_7_nen">#EAECF9</color>

    <!-- Gio ghi trong bong bong cua con. Tren nen brand, chu trang lam mo di
         khong ra duoc - phai la mot mau xanh nhat rieng. -->
    <color name="chat_gio_con">#BFD4FF</color>

    <!-- Mau cho hai nguoi dung, de phan biet ngay tu xa. -->
    <color name="parent_tint">#5B4BC4</color>
    <color name="parent_soft">#EDEAFB</color>
    <color name="child_tint">#0F8A8A</color>
    <color name="child_soft">#E3F5F5</color>

    <!-- Phan soan tap vo. Man hinh trong app dung chung bang mau o tren; rieng hai
         lop phu thi giu bang mau nay, vi chung nam de len app khac chu khong nam
         trong app. Nen dam de khong lan voi giao dien ben duoi, va de liec mot cai
         la biet day la app minh chu khong phai thong bao cua game.

         The nhac tach lam hai tong: xanh muc cho viec thuong, cam gach cho viec
         gap, de biet cai nao phai lam ngay ma khong can doc chu. -->
    <color name="st_the_nhac_nen">#15304C</color>
    <color name="st_the_nhac_nen_gap">#B44A22</color>
    <color name="st_the_nhac_chu">#FFFFFF</color>
    <color name="st_the_nhac_chu_mo">#B9C9D8</color>
    <color name="st_the_nhac_chu_mo_gap">#F3D6C6</color>

    <!-- Man chan gio di hoc: che kin man hinh nen khong can hoa voi gi ca, va nen
         dam thi do choi mat hon mot mang trang giua buoi sang. -->
    <color name="st_nen_chan">#FF0C1219</color>
    <color name="st_chu_chan">#FFFFFF</color>
    <color name="st_chu_chan_mo">#9FB2C2</color>
    <color name="st_chu_chan_nhan">#7FA8CC</color>
    <color name="st_vien_chan">#40FFFFFF</color>

    <!-- Net ke luoi thoi khoa bieu. Dam hon @color/line mot chut: net dut mong hon
         net lien nhieu, dung dung mot mau thi nhin nhu khong co. -->
    <color name="st_ke_luoi">#C8D0DC</color>
