<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HomeworkGate" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Man chup anh nen den de nhin ro khung hinh. -->
    <style name="Theme.HomeworkGate.Camera" parent="Theme.HomeworkGate">
        <item name="android:colorBackground">#101216</item>
        <item name="android:statusBarColor">#101216</item>
        <item name="android:navigationBarColor">#101216</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Chu to vi tablet de cach mat ca sai tay, va vi Le Hoa con nho. -->
    <style name="Text.Title" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Nhan cua mot nhom muc trong trang cai dat. Chu nho, in hoa, mau nhat:
         no la bien chi duong chu khong phai mot dong noi dung. -->
    <style name="Nhan.Nhom" parent="">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Elevated">
        <!-- Chi dinh han mau nen: de mac dinh thi Material3 pha them mau chu dao
             vao nen the, nhin ra mot mau hong nhat khong ai dat. -->
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/line</item>
    </style>
</resources>
