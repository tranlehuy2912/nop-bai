# Chep file nay thanh tools/bot.env roi dien vao. File bot.env khong vao git.
#
# TOKEN: mo Telegram, chat voi @BotFather, go /newbot, dat ten bot, no tra ve
#        mot chuoi dang 8123456789:AAH...
# CHATID: nhan tin bat ky cho bot vua tao, roi mo link nay tren trinh duyet:
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#        so trong "chat":{"id":...} chinh la chat id cua bo.
TOKEN=

# TOKEN_MAY_AO: token cua mot bot RIENG cho may ao. De trong thi may ao dung bot
# go loi ghi san trong Defaults. Dung dat token that o day: Telegram chi cho mot
# may nghe mot bot, may ao nghe chung voi tablet la hai ben giat tin cua nhau.
TOKEN_MAY_AO=
CHATID=
# So phut moi lan duyet khi thu tren may ao. De 3 phut cho khoi ngoi doi ca tieng.
MINUTES=3
