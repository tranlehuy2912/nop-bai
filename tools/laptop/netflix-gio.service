# Dich vu chay ngam cap gio Netflix cho tai khoan Le Hoa, xem netflix_gio.py.
[Unit]
Description=Cap gio Netflix tu tablet qua Firestore
# Khong ghi After=timekpr.service: timekpr.service tu ghi After=multi-user.target, ma dich vu
# nay WantedBy=multi-user.target, thanh vong. Luc khoi dong systemd bo viec bat dich vu nay de
# go vong (thay 7/10/2026). Timekpr-nExt chua chay thi netflix_gio.py ghi log roi thu vong sau.
After=network-online.target
Wants=network-online.target

[Service]
# python3 cua moi truong rieng (9/10/2026): co thu vien Firestore cho ket noi nghe, xem dau
# netflix_gio.py. Thieu moi truong do thi sua tam ve /usr/bin/python3: dich vu van chay, chi
# quay ve hoi Firestore mot phut mot lan.
ExecStart=/usr/local/lib/netflix-gio/venv/bin/python3 /usr/local/lib/netflix-gio/netflix_gio.py chay
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
