#!/bin/sh
# Phien dang nhap cua Le Hoa tren laptop (7/10/2026): chi co Firefox toan man hinh vao Netflix.
#
# /etc/X11/Xsession.d/98netflix-lehoa goi file nay thay cho MATE khi nguoi dang nhap la lehoa,
# du o man dang nhap con chon phien nao. Dong Firefox la het phien, quay ve man dang nhap.
#
# Luat chan web cua Firefox (/etc/firefox/policies/policies.json) ap cho ca may, va
# netflix_gio.py go no ra khi Ba Huy bam "Mở web" tren Bang dieu khien. Le Hoa dang nhap luc
# web dang mo thi chuong trinh do dat lai luat; o day cho toi khi luat co mat roi moi mo
# Firefox, de con khong vao web tu do trong may chuc giay truoc khi no kip dat.

LUAT=/etc/firefox/policies/policies.json
i=0
while ! grep -q WebsiteFilter "$LUAT" 2>/dev/null; do
    i=$((i + 1))
    # Hai phut ma van chua co luat (chuong trinh chay ngam chet?) thi thoi, khong mo gi.
    [ $i -gt 120 ] && exit 0
    sleep 1
done

# Chi xuat hinh ra tivi, do phan giai goc cua tivi (anh Huy chon 7/10/2026: hien giong nhau
# tren hai man thi tivi chay 1366x768 cua man laptop, hinh be, xem nhuc mat). Co man ngoai nao
# dang noi thi bat no o che do tot nhat (--auto) va tat man laptop; khong co thi giu man laptop.
# Tivi tat ma van cam HDMI thi xrandr van bao la noi, luc do man laptop den; anh Huy biet.
ngoai=$(xrandr --query | awk '$2 == "connected" && $1 !~ /^eDP/ {print $1; exit}')
trong=$(xrandr --query | awk '$2 == "connected" && $1 ~ /^eDP/ {print $1; exit}')
if [ -n "$ngoai" ]; then
    xrandr --output "$ngoai" --auto --primary --pos 0x0 ${trong:+--output "$trong" --off}
fi

# Het phut thi khong mo Netflix, chi hien mot hop chu roi dang xuat (7/10/2026). Khong co doan
# nay thi dang nhap luc 0 phut van xem duoc khoang 20 giay truoc khi Timekpr-nExt day ra, va bam
# dang nhap lien tuc la xem duoc tung doan. So giay lay tu file netflix_gio.py ghi, xem
# FILE_CON_LAI ben do. Thieu file hay doc khong ra so thi coi la het phut.
#
# Tu 8/10/2026 bat may la tu vao phien nay (80-netflix-lehoa.conf), ma luc do netflix_gio.py chua
# kip ghi file: no cho dong ho lay gio mang va cho Timekpr-nExt chay, lan thu 7/10/2026 la giay 99
# sau khi bat may. Khong cho thi con dang co phut van bi bao het phut. /run bi xoa moi lan khoi
# dong, nen thieu file gan nhu chac la vua bat may: cho toi da 3 phut, hien mot dong chu de tivi
# khong den trang. Qua 3 phut van thieu (chuong trinh chay ngam chet?) thi coi la het phut nhu cu.
if [ ! -f /run/netflix-gio/conlai ]; then
    zenity --info --title "Netflix" --width=460 \
        --text "Đang mở Netflix, chờ khoảng một phút." >/dev/null 2>&1 &
    cho=$!
    i=0
    while [ ! -f /run/netflix-gio/conlai ] && [ $i -lt 180 ]; do
        i=$((i + 1))
        sleep 1
    done
    kill $cho 2>/dev/null
fi
con=0
if read giay dung luc < /run/netflix-gio/conlai 2>/dev/null; then
    case "$giay$dung$luc" in
        *[!0-9]*|"") con=0 ;;
        *)
            con=$giay
            [ "$dung" = 1 ] && con=$((giay - ($(date +%s) - luc)))
            ;;
    esac
fi
if [ "$con" -le 30 ]; then
    zenity --info --title "Netflix" --width=460 --timeout=10 \
        --text "Hết phút xem Netflix.\n\nĐổi phút chơi trên tablet rồi đăng nhập lại. Nếu vừa đổi thì chờ một phút." \
        2>/dev/null
    exit 0
fi

# Trinh quan ly cua so cho ban phim va thong bao chay dung.
#
# Khong chay timekprc (phan bao gio cua Timekpr-nExt): no bao bang tieng Anh, anh Huy chi muon
# mot thong bao tieng Viet, do netflix_gio.py gui luc con 5 phut (7/10/2026). Dem gio va dang
# xuat la viec cua phan chay ngam timekprd, khong can timekprc.
marco &
# Nut "Thoát" hien khi re chuot vao goc phai tren, xem netflix-thoat.
netflix-thoat &

# Sua prefs.js cua ho so truoc moi lan mo. Tu lan mo thu hai, Firefox doc lai prefs.js no tu ghi
# lan truoc va man chi con mau den du trang da tai (thay 7/10/2026). Chia doi prefs.js tren laptop
# (7/10/2026) thi man den chi hien khi co ca hai nhom dong: ba dong ghi da cai goi ngon ngu kem
# Firefox (extensions.installedDistroAddon.langpack-en-CA, -en-GB, -vi, goi nam o
# /usr/lib/firefox/distribution/extensions), va cac dong ghi Firefox van cung ban voi lan truoc
# (extensions.lastAppBuildId, extensions.lastAppVersion). Bo mot trong hai nhom la ve binh thuong,
# nen chi xoa nhom dau. Co le luat chan moi tien ich (ExtensionSettings "*": blocked) da go goi
# ngon ngu (thu muc extensions cua ho so trong) ma Firefox van tin la da cai; chua kiem chung.
#
# Truoc day xoa ca prefs.js. Lam vay thi mat luon dau "da cai Widevine" (media.gmp-widevinecdm.*),
# lan nao Firefox cung tai lai Widevine, hien "Firefox is installing components needed to play the
# audio or video..." va phai cho tai xong moi chieu duoc phim. Cai dat can giu nam trong luat
# Firefox (/etc/firefox/policies), dang nhap Netflix nam trong cookies.sqlite.
#
# Giu prefs.js thi co mot lan Firefox hien thanh "Open previous tabs?", bam nut tren thanh do la
# mo menu cua Firefox. Thanh nay chi hien khi browser.startup.couldRestoreSession.count bang 1
# (xem SessionWindowUI.sys.mjs cua Firefox 146), tu 2 tro len la thoi, nen dat san so dem la 2.
for f in "$HOME"/.mozilla/firefox/*/prefs.js; do
    [ -f "$f" ] || continue
    sed -i -e '/"extensions\.installedDistroAddon\./d' \
        -e '/"browser\.startup\.couldRestoreSession\.count"/d' "$f"
    echo 'user_pref("browser.startup.couldRestoreSession.count", 2);' >> "$f"
done

# Lan tai dau sau khi Firefox bat co luc khong ve xong (chi co nen do, 8/10/2026), nen
# netflix-canh xem man mot luc dau va tu bam F5 khi trang con trong; xem dau file do. Truoc
# 8/10/2026 o day cu 5 giay chua thay chu Netflix tren tieu de la goi lai "firefox URL" (tuong
# Firefox 146 bo qua dia chi luc khoi dong, thay 7/10/2026). Nhat ky 8/10/2026 cho thay Firefox
# van tai dia chi do, chi cham, con moi lan goi lai la them mot the Netflix cung tai, nen bo.
URL=https://www.netflix.com/
firefox --kiosk "$URL" &
ff=$!
netflix-canh $ff "$URL" &
wait $ff
