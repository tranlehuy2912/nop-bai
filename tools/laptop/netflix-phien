#!/bin/sh
# Phien dang nhap cua Le Hoa tren laptop (7/10/2026): chi co man chon va Firefox toan man hinh.
#
# Tu 9/10/2026 phien nay xem duoc ca Netflix lan YouTube, chung mot quy phut (anh Huy chon mot tai
# khoan, chon trong phien): vao phien la hien man chon (netflix-chon), chon gi thi mo Firefox toan
# man hinh vao do, bam nut ✕ (netflix-thoat dong Firefox) thi quay ve man chon. Chi nut "Thoát" o
# man chon, hay de man chon qua 2 phut khong ai bam, moi dang xuat. Truoc 9/10/2026 phien chi co
# Netflix, dong Firefox la dang xuat.
#
# /etc/X11/Xsession.d/98netflix-lehoa goi file nay thay cho MATE khi nguoi dang nhap la lehoa,
# du o man dang nhap con chon phien nao. File nay chay xong la het phien, quay ve man dang nhap.
#
# Luat chan web cua Firefox (/etc/firefox/policies/policies.json) ap cho ca may, va
# netflix_gio.py go no ra khi Ba Huy bam "Mở web" tren Bang dieu khien. Le Hoa dang nhap luc
# web dang mo thi chuong trinh do dat lai luat; o day cho toi khi luat co mat roi moi mo
# Firefox, de con khong vao web tu do trong may chuc giay truoc khi no kip dat.

# Luc dang nhap, de man chon dem lui dung ngay tu giay dau (xem con_lai trong netflix-chon).
PHIEN_TU=$(date +%s)
export PHIEN_TU

LUAT=/etc/firefox/policies/policies.json
i=0
while ! grep -q WebsiteFilter "$LUAT" 2>/dev/null; do
    i=$((i + 1))
    # Hai phut ma van chua co luat (chuong trinh chay ngam chet?) thi thoi, khong mo gi.
    [ $i -gt 120 ] && exit 0
    sleep 1
done

# Chi xuat hinh ra tivi, do phan giai goc cua tivi (anh Huy chon 7/10/2026: hien giong nhau
# tren hai man thi tivi chay 1366x768 cua man laptop, hinh be, xem nhuc mat). Co man ngoai nao
# dang noi thi bat no o che do tot nhat (--auto) va tat man laptop; khong co thi giu man laptop.
# Tivi tat ma van cam HDMI thi xrandr van bao la noi, luc do man laptop den; anh Huy biet.
ngoai=$(xrandr --query | awk '$2 == "connected" && $1 !~ /^eDP/ {print $1; exit}')
trong=$(xrandr --query | awk '$2 == "connected" && $1 ~ /^eDP/ {print $1; exit}')
if [ -n "$ngoai" ]; then
    xrandr --output "$ngoai" --auto --primary --pos 0x0 ${trong:+--output "$trong" --off}
fi

# Het phut thi khong mo gi, chi hien mot hop chu roi dang xuat (7/10/2026). Khong co doan nay
# thi dang nhap luc 0 phut van xem duoc khoang 20 giay truoc khi Timekpr-nExt day ra, va bam
# dang nhap lien tuc la xem duoc tung doan. So giay lay tu file netflix_gio.py ghi, xem
# FILE_CON_LAI ben do. Thieu file hay doc khong ra so thi coi la het phut. Man chon cung tu xet
# file do moi giay, het phut thi tra ma 3 va o day hien cung hop chu.
#
# Tu 8/10/2026 bat may la tu vao phien nay (80-netflix-lehoa.conf), ma luc do netflix_gio.py chua
# kip ghi file: no cho dong ho lay gio mang va cho Timekpr-nExt chay, lan thu 7/10/2026 la giay 99
# sau khi bat may. Khong cho thi con dang co phut van bi bao het phut. /run bi xoa moi lan khoi
# dong, nen thieu file gan nhu chac la vua bat may: cho toi da 3 phut, hien mot dong chu de tivi
# khong den trang. Qua 3 phut van thieu (chuong trinh chay ngam chet?) thi coi la het phut nhu cu.
if [ ! -f /run/netflix-gio/conlai ]; then
    zenity --info --title "Xem phim" --width=460 \
        --text "Đang khởi động, chờ khoảng một phút." >/dev/null 2>&1 &
    cho=$!
    i=0
    while [ ! -f /run/netflix-gio/conlai ] && [ $i -lt 180 ]; do
        i=$((i + 1))
        sleep 1
    done
    kill $cho 2>/dev/null
fi
con=0
if read giay dung luc < /run/netflix-gio/conlai 2>/dev/null; then
    case "$giay$dung$luc" in
        *[!0-9]*|"") con=0 ;;
        *)
            con=$giay
            [ "$dung" = 1 ] && con=$((giay - ($(date +%s) - luc)))
            ;;
    esac
fi
het_phut() {
    zenity --info --title "Xem phim" --width=460 --timeout=10 \
        --text "Hết phút xem phim.\n\nĐổi phút chơi trên tablet rồi đăng nhập lại. Nếu vừa đổi thì chờ một chút." \
        2>/dev/null
    exit 0
}
[ "$con" -le 30 ] && het_phut

# Trinh quan ly cua so cho ban phim va thong bao chay dung.
#
# Khong chay timekprc (phan bao gio cua Timekpr-nExt): no bao bang tieng Anh, anh Huy chi muon
# mot thong bao tieng Viet, do netflix_gio.py gui luc con 5 phut (7/10/2026). Dem gio va dang
# xuat la viec cua phan chay ngam timekprd, khong can timekprc.
marco &

# Sua prefs.js cua ho so truoc moi lan mo. Tu lan mo thu hai, Firefox doc lai prefs.js no tu ghi
# lan truoc va man chi con mau den du trang da tai (thay 7/10/2026). Chia doi prefs.js tren laptop
# (7/10/2026) thi man den chi hien khi co ca hai nhom dong: ba dong ghi da cai goi ngon ngu kem
# Firefox (extensions.installedDistroAddon.langpack-en-CA, -en-GB, -vi, goi nam o
# /usr/lib/firefox/distribution/extensions), va cac dong ghi Firefox van cung ban voi lan truoc
# (extensions.lastAppBuildId, extensions.lastAppVersion). Bo mot trong hai nhom la ve binh thuong,
# nen chi xoa nhom dau. Co le luat chan moi tien ich (ExtensionSettings "*": blocked) da go goi
# ngon ngu (thu muc extensions cua ho so trong) ma Firefox van tin la da cai; chua kiem chung.
#
# Truoc day xoa ca prefs.js. Lam vay thi mat luon dau "da cai Widevine" (media.gmp-widevinecdm.*),
# lan nao Firefox cung tai lai Widevine, hien "Firefox is installing components needed to play the
# audio or video..." va phai cho tai xong moi chieu duoc phim. Cai dat can giu nam trong luat
# Firefox (/etc/firefox/policies), dang nhap Netflix nam trong cookies.sqlite.
#
# Giu prefs.js thi co mot lan Firefox hien thanh "Open previous tabs?", bam nut tren thanh do la
# mo menu cua Firefox. Thanh nay chi hien khi browser.startup.couldRestoreSession.count bang 1
# (xem SessionWindowUI.sys.mjs cua Firefox 146), tu 2 tro len la thoi, nen dat san so dem la 2.
#
# Mo YouTube thi them cac dong bat YouTube gui H.264 (9/10/2026, anh Huy chon sau khi do tren
# laptop nay, video 1080p 60 khung): chip Haswell giai ma phan cung duoc H.264 ma khong duoc VP9,
# AV1. De mac dinh thi YouTube gui AV1, Firefox giai bang chip chinh va video cu tu khoi dong lai;
# ep H.264 thi 0 khung roi tren 2.403, chip chinh khoang 32%. YouTube chon dinh dang theo nhung gi
# Firefox bao la phat duoc: tat WebM trong MediaSource, tat VP9 trong MediaSource (giao dien tivi
# hoi ca VP9 boc trong MP4, Firefox van bao la phat duoc) va tat AV1 thi chi con H.264.
#
# Va them dong tu xung la may PS4, de YouTube mo giao dien danh cho tivi (youtube.com/tv; anh Huy
# chot 9/10/2026: ep xem toan man hinh, khong cho xem trong khung nho): video nao cung chieu kin
# man hinh, chuot bam duoc nut, video, chu tren ban phim cua no, Esc hay nut mui ten la ve danh
# sach, dang nhap bang ma tren dien thoai (yt.be/activate) nen khong ai go mat khau tren laptop.
# Trang youtube.com/tv chi mo cho thiet bi tivi; voi nhan dang cua Firefox tren may tinh, Google
# chuyen ve trang thuong (co khung nho). Ngay nao Google chan nhan dang nay thi YouTube ve trang
# thuong, khong hong gi them.
#
# Mo Netflix thi go het cac dong do ra, de Netflix chay y nhu truoc (chua do Netflix voi H.264, vi
# ho so Netflix nao cung khoa PIN). Firefox ghi cai dat dang dung vao prefs.js luc thoat, nen phai
# go o day chu khong chi them luc mo YouTube.
UA_TIVI='Mozilla/5.0 (PS4; Leanback Shell) Gecko/20100101 Firefox/65.0 LeanbackShell/01.00.01.75 Sony PS4/ (PS4, , no, CH)'
sua_prefs() {
    for f in "$HOME"/.mozilla/firefox/*/prefs.js; do
        [ -f "$f" ] || continue
        sed -i -e '/"extensions\.installedDistroAddon\./d' \
            -e '/"browser\.startup\.couldRestoreSession\.count"/d' \
            -e '/"media\.mediasource\.webm\.enabled"/d' \
            -e '/"media\.mediasource\.vp9\.enabled"/d' \
            -e '/"media\.av1\.enabled"/d' \
            -e '/"general\.useragent\.override"/d' "$f"
        echo 'user_pref("browser.startup.couldRestoreSession.count", 2);' >> "$f"
        if [ "$1" = youtube ]; then
            echo 'user_pref("media.mediasource.webm.enabled", false);' >> "$f"
            echo 'user_pref("media.mediasource.vp9.enabled", false);' >> "$f"
            echo 'user_pref("media.av1.enabled", false);' >> "$f"
            echo "user_pref(\"general.useragent.override\", \"$UA_TIVI\");" >> "$f"
        fi
    done
}

# Lan tai dau sau khi Firefox bat co luc khong ve xong (chi co nen do, 8/10/2026), nen
# netflix-canh xem man mot luc dau va tu bam F5 khi trang con trong; xem dau file do. Truoc
# 8/10/2026 o day cu 5 giay chua thay chu Netflix tren tieu de la goi lai "firefox URL" (tuong
# Firefox 146 bo qua dia chi luc khoi dong, thay 7/10/2026). Nhat ky 8/10/2026 cho thay Firefox
# van tai dia chi do, chi cham, con moi lan goi lai la them mot the Netflix cung tai, nen bo.
# Moi lan chon la mot lan bat Firefox, nen van canh moi lan mo Netflix. YouTube thi khong canh:
# netflix-canh chi hieu trang Netflix (cho chu Netflix tren tieu de, xem nen trang la trang trong).
#
# Nut ✕ (netflix-thoat) chi chay cung Firefox: o man chon thi khong co Firefox de dong.
# Ma tra ve cua man chon xem dau file netflix-chon.
hong=
while :; do
    netflix-chon
    ma=$?
    case $ma in
        10) loai=netflix; URL=https://www.netflix.com/ ;;
        11) loai=youtube; URL=https://www.youtube.com/tv ;;
        3) het_phut ;;
        0) exit 0 ;;
        *)
            # Man chon hong (thieu thu vien, loi Python...): mo Netflix nhu truoc 9/10/2026 va dong
            # Firefox la dang xuat, de con van xem duoc ma khong ket trong vong man chon hong.
            logger -t netflix-phien "man chon tra ma $ma, mo Netflix nhu cu"
            loai=netflix; URL=https://www.netflix.com/; hong=1 ;;
    esac
    logger -t netflix-phien "mo $loai"
    sua_prefs $loai
    firefox --kiosk "$URL" &
    ff=$!
    netflix-thoat &
    nut=$!
    if [ $loai = netflix ]; then
        netflix-canh $ff "$URL" &
    fi
    wait $ff
    kill $nut 2>/dev/null
    [ -n "$hong" ] && exit 0
done
