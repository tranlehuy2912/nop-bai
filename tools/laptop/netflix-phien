#!/bin/sh
# Phien dang nhap cua Le Hoa tren laptop (7/10/2026): chi co Firefox toan man hinh vao Netflix.
#
# /etc/X11/Xsession.d/98netflix-lehoa goi file nay thay cho MATE khi nguoi dang nhap la lehoa,
# du o man dang nhap con chon phien nao. Dong Firefox la het phien, quay ve man dang nhap.
#
# Luat chan web cua Firefox (/etc/firefox/policies/policies.json) ap cho ca may, va
# netflix_gio.py go no ra khi Ba Huy bam "Mở web" tren Bang dieu khien. Le Hoa dang nhap luc
# web dang mo thi chuong trinh do dat lai luat; o day cho toi khi luat co mat roi moi mo
# Firefox, de con khong vao web tu do trong may chuc giay truoc khi no kip dat.

LUAT=/etc/firefox/policies/policies.json
i=0
while ! grep -q WebsiteFilter "$LUAT" 2>/dev/null; do
    i=$((i + 1))
    # Hai phut ma van chua co luat (chuong trinh chay ngam chet?) thi thoi, khong mo gi.
    [ $i -gt 120 ] && exit 0
    sleep 1
done

# Chi xuat hinh ra tivi, do phan giai goc cua tivi (anh Huy chon 7/10/2026: hien giong nhau
# tren hai man thi tivi chay 1366x768 cua man laptop, hinh be, xem nhuc mat). Co man ngoai nao
# dang noi thi bat no o che do tot nhat (--auto) va tat man laptop; khong co thi giu man laptop.
# Tivi tat ma van cam HDMI thi xrandr van bao la noi, luc do man laptop den; anh Huy biet.
ngoai=$(xrandr --query | awk '$2 == "connected" && $1 !~ /^eDP/ {print $1; exit}')
trong=$(xrandr --query | awk '$2 == "connected" && $1 ~ /^eDP/ {print $1; exit}')
if [ -n "$ngoai" ]; then
    xrandr --output "$ngoai" --auto --primary --pos 0x0 ${trong:+--output "$trong" --off}
fi

# Het phut thi khong mo Netflix, chi hien mot hop chu roi dang xuat (7/10/2026). Khong co doan
# nay thi dang nhap luc 0 phut van xem duoc khoang 20 giay truoc khi Timekpr-nExt day ra, va bam
# dang nhap lien tuc la xem duoc tung doan. So giay lay tu file netflix_gio.py ghi, xem
# FILE_CON_LAI ben do. Thieu file hay doc khong ra so thi coi la het phut.
con=0
if read giay dung luc < /run/netflix-gio/conlai 2>/dev/null; then
    case "$giay$dung$luc" in
        *[!0-9]*|"") con=0 ;;
        *)
            con=$giay
            [ "$dung" = 1 ] && con=$((giay - ($(date +%s) - luc)))
            ;;
    esac
fi
if [ "$con" -le 30 ]; then
    zenity --info --title "Netflix" --width=460 --timeout=10 \
        --text "Hết phút xem Netflix.\n\nĐổi phút chơi trên tablet rồi đăng nhập lại. Nếu vừa đổi thì chờ một phút." \
        2>/dev/null
    exit 0
fi

# Trinh quan ly cua so cho ban phim va thong bao chay dung.
#
# Khong chay timekprc (phan bao gio cua Timekpr-nExt): no bao bang tieng Anh, anh Huy chi muon
# mot thong bao tieng Viet, do netflix_gio.py gui luc con 5 phut (7/10/2026). Dem gio va dang
# xuat la viec cua phan chay ngam timekprd, khong can timekprc.
marco &
# Nut "Thoát" hien khi re chuot vao goc phai tren, xem netflix-thoat.
netflix-thoat &

# Xoa prefs.js cua ho so truoc moi lan mo. Tu lan mo thu hai, Firefox doc lai prefs.js no tu ghi
# lan truoc va man chi con mau den du trang da tai (thay 7/10/2026; xoa file nay thi ve lai binh
# thuong, chua do ra dong nao gay loi). Cai dat can giu deu nam trong luat Firefox
# (/etc/firefox/policies), dang nhap Netflix nam trong cookies.sqlite, nen xoa khong mat gi.
for f in "$HOME"/.mozilla/firefox/*/prefs.js; do
    rm -f "$f"
done

# Tu lan mo thu hai voi cung ho so, Firefox 146 bo qua dia chi truyen luc khoi dong va mo mot
# trang trong (man den, tieu de "Mozilla Firefox"; thay 7/10/2026, lan dau ho so moi thi duoc).
# Gui lai dia chi cho Firefox dang chay thi no tai ngay, nen cho cua so hien roi gui lai neu
# tieu de chua co chu Netflix.
URL=https://www.netflix.com/
firefox --kiosk "$URL" &
ff=$!
i=0
while kill -0 $ff 2>/dev/null && [ $i -lt 30 ]; do
    i=$((i + 1))
    sleep 1
    ten=$(xdotool getactivewindow getwindowname 2>/dev/null)
    case "$ten" in
        *Netflix*) break ;;
        "") ;;
        *) [ $((i % 5)) -eq 0 ] && firefox "$URL" ;;
    esac
done
wait $ff
